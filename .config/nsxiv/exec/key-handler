#!/bin/sh
# nsxiv key-handler: pressed key in $1, target files on stdin (one per
# line) — the marked set, or the current file if nothing is marked.
# Trigger with Ctrl-x then the key below.

case "$1" in
"d")
    # reversible delete -> FreeDesktop trash (trash-cli)
    while read -r file; do
        trash-put -- "$file"
    done ;;
"D")
    # permanent delete -- no undo
    while read -r file; do
        rm -- "$file"
    done ;;
esac
