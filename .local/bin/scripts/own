#!/bin/sh -e
# Recursively take ownership of the given files or the current directory
u=$USER
case "$1" in
	(+*) sudo chmod -R "$1" "${@:-.}"; shift; break;;
	(-*) u="${1#-}"; shift; break;;
esac
if chown --help 2>&1 | grep -q -- '--preserve-root'
then sudo chown -R --preserve-root "$u:$u" "${@:-.}"
else sudo chown -R "$u:$u" "${@:-.}"
fi
#sudo chmod u+w . -R
