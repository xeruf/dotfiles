#!/bin/sh -e
# Kil all Java processes except IDEA
# Pass "-9" to force-kill and "-q" to not output what has been killed
pgrep -f 'java' | while read id
	do if [[ $(ps -p $id -o command=) != *"idea"* ]]; then
		[[ "$@" == "-q" ]] || echo "killing $(ps -p $id -o pid=,command=)"
		if [[ "$@" == "-9" ]]
		then kill -9 $id
		else kill $id
		fi
	fi; done
