#!/bin/sh
# Check an App Store Connect API key against Apple and store a repo's iOS signing secrets on GitHub — usage: --help.
usage() { cat <<'EOF'
Usage: ios-ci-secrets [--set [--password] [--force]] KEY_DIR

Run inside the git repo whose GitHub Actions release needs the secrets.
Tests the App Store Connect API key in KEY_DIR against Apple (read-only, through
the repo's scripts/asc-profiles.py --dry-run), and with --set stores the signing
secrets from the same files on the repo's GitHub remote.

  KEY_DIR     the folder holding, each exactly once:
                *.p8    the API key, its 10-character key id at the end of the name
                        (AuthKey_ABCDE12345.p8, as Apple names the download)
                *.p12   the distribution certificate
                *.txt   one of them containing the issuer id (a UUID)
  (no flag)   only the check
  --set       after a successful check, store the four secrets that come from files
  --password  with --set, also ask for the .p12 password and store it
  --force     with --set, store even if the check fails
  -h, --help  this text

Secrets written: APPSTORE_API_KEY_ID, APPSTORE_API_ISSUER_ID, APPSTORE_API_PRIVATE_KEY,
APPLE_DISTRIBUTION_P12 and, with --password, APPLE_DISTRIBUTION_P12_PASSWORD.
Nothing is printed except names; values go straight from the files into `gh secret set`.
EOF
}
set -eu

set_secrets=0 force=0 password=0 dir=''
for arg in "$@"; do
  case "$arg" in
    --set) set_secrets=1 ;;
    --force) force=1 ;;
    --password) password=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "error: ios-ci-secrets: unknown option '$arg' (see --help)" >&2; exit 2 ;;
    *) dir="$arg" ;;
  esac
done
[ -n "$dir" ] || { usage >&2; exit 2; }
[ -d "$dir" ] || { echo "error: ios-ci-secrets: no folder $dir" >&2; exit 1; }

only() {  # extension → the one file with it, or an error
  n=$(find "$dir" -maxdepth 1 -type f -name "*.$1" | wc -l | tr -d ' ')
  [ "$n" -eq 1 ] || { echo "error: ios-ci-secrets: $n *.$1 files in the key folder, need exactly one" >&2; exit 1; }
  find "$dir" -maxdepth 1 -type f -name "*.$1"
}
p8=$(only p8)
p12=$(only p12)
key_id=$(basename "$p8" .p8 | sed 's/.*[^A-Za-z0-9]//')
case "$key_id" in
  ??????????) ;;
  *) echo "error: ios-ci-secrets: the .p8's name does not end in a 10-character key id" >&2; exit 1 ;;
esac
issuer=$(cat "$dir"/*.txt 2>/dev/null |
  grep -Eio '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | head -n 1 || true)
[ -n "$issuer" ] || { echo "error: ios-ci-secrets: no issuer id (a UUID) in the key folder's *.txt" >&2; exit 1; }

root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "error: ios-ci-secrets: not inside a git repo" >&2; exit 1; }
cd "$root"
[ -f scripts/asc-profiles.py ] || { echo "error: ios-ci-secrets: this repo has no scripts/asc-profiles.py to check the key with" >&2; exit 1; }
repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner) || { echo "error: ios-ci-secrets: no GitHub repo for this checkout (gh repo view)" >&2; exit 1; }

echo "key id and issuer id found, checking against Apple for $repo (read-only dry run)…"
if ASC_KEY_ID="$key_id" ASC_ISSUER_ID="$issuer" ASC_KEY_PATH="$p8" python3 scripts/asc-profiles.py --dry-run >/dev/null; then
  echo "Apple accepts the key."
elif [ "$set_secrets" -eq 1 ] && [ "$force" -eq 1 ]; then
  echo "dry run failed, continuing because of --force" >&2
else
  echo "error: ios-ci-secrets: Apple rejected the key or the dry run failed; for details run by hand:" >&2
  echo "  ASC_KEY_ID=… ASC_ISSUER_ID=… ASC_KEY_PATH=… python3 scripts/asc-profiles.py --dry-run" >&2
  if [ "$set_secrets" -eq 1 ]; then echo "  nothing was stored; use --force to store anyway" >&2; fi
  exit 1
fi
[ "$set_secrets" -eq 1 ] || exit 0

printf '%s' "$key_id" | gh secret set APPSTORE_API_KEY_ID -R "$repo"
printf '%s' "$issuer" | gh secret set APPSTORE_API_ISSUER_ID -R "$repo"
base64 -i "$p8" | tr -d '\n' | gh secret set APPSTORE_API_PRIVATE_KEY -R "$repo"
base64 -i "$p12" | tr -d '\n' | gh secret set APPLE_DISTRIBUTION_P12 -R "$repo"
if [ "$password" -eq 1 ]; then
  gh secret set APPLE_DISTRIBUTION_P12_PASSWORD -R "$repo"
fi
echo "Stored for $repo. Re-run a failed release job: gh run rerun <id> -R $repo --failed"
